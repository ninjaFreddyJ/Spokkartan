{
  "crons": [
    { "path": "/api/cron-nurture", "schedule": "0 * * * *" }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/llms.txt", "destination": "/api/llms" },
    {
      "source": "/:path*",
      "has": [
        { "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|LinkedInBot|Discordbot|TelegramBot|Pinterest|redditbot|Embedly|vkShare|Applebot|Applebot-Extended|Googlebot|Google-Extended|Bingbot|DuckDuckBot|Slurp|YandexBot|Baiduspider|OAI-SearchBot|ChatGPT-User|GPTBot|PerplexityBot|Perplexity-User|ClaudeBot|Claude-SearchBot|Anthropic|Amazonbot|Bytespider|CCBot).*" }
      ],
      "destination": "/api/prerender?path=/:path*"
    },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(sv|en|de|no|da)/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "all" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
